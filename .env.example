# ElxMCP — copy to `.env` and fill in. Never commit real secrets.
# Loaded automatically by config/runtime.exs (does not override vars already set in the shell).

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Only for releases (bin/elx_mcp start). Leave commented for mix test / mix phx.server.
# PHX_SERVER=true
PORT=4000
PHX_HOST=localhost

# Required in production — generate with: mix phx.gen.secret
SECRET_KEY_BASE=change_me_generate_with_mix_phx_gen_secret

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
#
# Prefer discrete vars (user / password / host). Optionally set DATABASE_URL instead.
# If both are set, DATABASE_URL wins (except tests prefer DATABASE_URL_TEST).
#
# REQUIRED when not using DATABASE_URL*: DB_USER, DB_PASSWORD, DB_HOST
# (runtime.exs does NOT fall back to postgres/postgres/localhost).
# -----------------------------------------------------------------------------

# --- Discrete (recommended for local dev) ---
# Prefer a dedicated role that only owns elx_mcp_dev / elx_mcp_test (see spec/DB_SEC.md).
DB_USER=elx_mcp_dev
DB_PASSWORD=your_strong_db_password
DB_HOST=your_db_host
# Hermes ElxMCP cluster currently listens on 5481 (not default 5432).
DB_PORT=5481
DB_NAME=elx_mcp_dev

# Test database (defaults to elx_mcp_test if unset)
DB_NAME_TEST=elx_mcp_test

# SSL: true | false | verify_none
# Prefer true + peer verify. For hermes self-signed:
#   DB_SSL=true
#   DB_SSL_CA=priv/certs/hermes-pg-ca.pem
#   DB_SSL_HOSTNAME=vps8383.panel.icontainer.net
# verify_none only for loopback lab (MITM risk on remote hosts).
DB_SSL=true
# DB_SSL_CA=priv/certs/hermes-pg-ca.pem
# DB_SSL_HOSTNAME=vps8383.panel.icontainer.net

# Connection pool size (dev/prod; tests use scheduler count)
POOL_SIZE=10

# IPv6 sockets (true/1 to enable)
ECTO_IPV6=false

# --- Or a single URL (optional; overrides discrete when set) ---
# DATABASE_URL=ecto://USER:PASSWORD@HOST:5481/elx_mcp_dev
# DATABASE_URL_TEST=ecto://USER:PASSWORD@HOST:5481/elx_mcp_test

# CI test partition suffix (appended to DB_NAME_TEST / default test name)
# MIX_TEST_PARTITION=

# -----------------------------------------------------------------------------
# MCP CORS (production: comma-separated origins; never * in prod)
# Dev uses allow_cors_star in config/dev.exs; this mainly affects prod runtime.
# -----------------------------------------------------------------------------
MCP_CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Encrypted DB backups (scripts/db_backup.sh / mix db.backup)
# -----------------------------------------------------------------------------
# ELX_MCP_BACKUP_PASSPHRASE=generate_a_long_random_passphrase
# ELX_MCP_BACKUP_DIR=priv/backups

# -----------------------------------------------------------------------------
# Clustering (optional)
# -----------------------------------------------------------------------------
DNS_CLUSTER_QUERY=

# -----------------------------------------------------------------------------
# Mailer / TLS (optional)
# -----------------------------------------------------------------------------
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# SOME_APP_SSL_KEY_PATH=
# SOME_APP_SSL_CERT_PATH=
