# ElxMCP — copy to `.env` and fill in. Never commit real secrets.
# Loaded automatically by config/runtime.exs (does not override vars already set in the shell).

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Only for releases (bin/elx_mcp start). Leave commented for mix test / mix phx.server.
# PHX_SERVER=true
PORT=4000
PHX_HOST=localhost

# Required in production — generate with: mix phx.gen.secret
SECRET_KEY_BASE=change_me_generate_with_mix_phx_gen_secret

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
#
# Prefer discrete vars (user / password / host). Optionally set DATABASE_URL instead.
# If both are set, DATABASE_URL wins (except tests prefer DATABASE_URL_TEST).
# -----------------------------------------------------------------------------

# --- Discrete (recommended for local dev) ---
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_PORT=5432
DB_NAME=elx_mcp_dev

# Test database (defaults to elx_mcp_test if unset)
DB_NAME_TEST=elx_mcp_test

# SSL: true | false | verify_none
# Dev/test often use verify_none (self-signed). Production defaults to true if unset.
DB_SSL=verify_none

# Connection pool size (dev/prod; tests use scheduler count)
POOL_SIZE=10

# IPv6 sockets (true/1 to enable)
ECTO_IPV6=false

# --- Or a single URL (optional; overrides discrete when set) ---
# DATABASE_URL=ecto://USER:PASSWORD@HOST:5432/elx_mcp_dev
# DATABASE_URL_TEST=ecto://USER:PASSWORD@HOST:5432/elx_mcp_test

# CI test partition suffix (appended to DB_NAME_TEST / default test name)
# MIX_TEST_PARTITION=

# -----------------------------------------------------------------------------
# MCP CORS (production: comma-separated origins; never * in prod)
# Dev uses allow_cors_star in config/dev.exs; this mainly affects prod runtime.
# -----------------------------------------------------------------------------
MCP_CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Clustering (optional)
# -----------------------------------------------------------------------------
DNS_CLUSTER_QUERY=

# -----------------------------------------------------------------------------
# Mailer / TLS (optional)
# -----------------------------------------------------------------------------
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# SOME_APP_SSL_KEY_PATH=
# SOME_APP_SSL_CERT_PATH=
